  "evaluation_protocol": {
    "gate_unit": "complete independently reset causally replayed labelled scenario, clustered by source/framework/run; session metrics are secondary",
    "primary_positive_scenario": "Full acquisition run containing explicitly labelled malicious TLS sessions; qualifying ENCRYPTED_MALWARE alert must match a malicious session UID/tuple/time and occur before last raw scenario event. A benign-flow alert cannot count as TP.",
    "primary_benign_scenario": "Separately captured documented benign-only complete application/control scenario, with no malicious or unknown intent within evaluated TLS scope; any ENCRYPTED_MALWARE alert is FP. Do not manufacture it by deleting positive/background packets from a mixed capture.",
    "mixed_capture_controls": "Preserve matched benign background, report session-level FP/FN separately; same-run sessions are clustered and cannot inflate independent scenario counts.",
    "parser_blind_positives": "Genuinely labelled TLS sessions/scenarios not observed or not detected count as missed in the declared input scope. Do not select evaluation sessions by ClientHello parsing success or detector output. Report visibility separately.",
    "unknown_intent": "Never assign a synthetic positive/benign label to unknown background; insufficiently labelled complete scenarios do not supply quantitative gate metrics.",
    "confidence_intervals": "Report uncertainty/cluster denominators and per-family/per-control counts; point gates alone do not establish population FPR/generalization.",
    "frozen_promotion_gate": {
      "recall_min": 0.8,
      "precision_min": 0.95,
      "benign_scenario_fpr_max": 0.02,
      "positive_alert_before_final_event": true
    },
    "gate_ref": "docs/ENCRYPTED_SESSION_VALIDATION.md",
    "fail_action": "No gate lowering or reserved tuning; candidate disabled; failure analysis only and one unimplemented smallest next experiment."
  },
