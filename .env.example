# PS26145 Environment Configuration

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_SECRET_TOKEN=ps26145-dev-secret-token-change-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
DATABASE_URL=sqlite:///./persistence/ps26145.db

# Message Bus (Redis Streams)
# For local dev without a running Redis server, the pipeline can fallback to embedded fakeredis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_INGEST=traffic:stream:ingest
REDIS_STREAM_ALERTS=threat:stream:alerts
USE_FAKEREDIS=true

# Pipeline Parameters
BATCH_SIZE=100
MAX_LATENCY_MS=2000
WATERMARK_DELAY_MS=500
LOG_LEVEL=INFO
